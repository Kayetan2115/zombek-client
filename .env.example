# =====================================================================
# ZombekClient — Konfiguracja Środowiskowa (.env)
# =====================================================================
# Skopiuj ten plik do .env przed uruchomieniem aplikacji w trybie developerskim:
#   cp .env.example .env
#
# Więcej szczegółów dotyczących rejestracji w Microsoft Entra ID znajdziesz w:
#   docs/microsoft-auth-setup.md
# =====================================================================

# Identyfikator aplikacji Microsoft Entra ID (Public Client / Desktop)
# Zarejestruj własną aplikację w Microsoft Entra (https://portal.azure.com):
# - Obsługiwane typy kont: Osobiste konta Microsoft (Personal Microsoft accounts only)
# - Typ klienta: Public client / Native (Aplikacja klasyczna lub mobilna)
# - Redirect URI: http://127.0.0.1/callback lub msal<CLIENT_ID>://auth
MICROSOFT_CLIENT_ID=

# Środowisko uruchomieniowe (development | production | test)
NODE_ENV=development
