{
  "name": "@zombek/config-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Configuration schema and validation models for ZombekClient",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zombek/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
