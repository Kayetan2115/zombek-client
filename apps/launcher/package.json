{
  "name": "@zombek/launcher",
  "version": "0.1.0",
  "private": true,
  "description": "ZombekClient Desktop Launcher based on Electron, React, and Vite",
  "type": "module",
  "main": "./dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "pnpm run build:electron && pnpm run build:renderer",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zombek/config-schema": "workspace:*",
    "@zombek/contracts": "workspace:*",
    "@zombek/shared-types": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
